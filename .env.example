# ---- Neon Postgres (pooled, SSL) ----
DATABASE_URL=jdbc:postgresql://<host>/<db>?sslmode=require
PGUSER=<user>
PGPASSWORD=<password>

# ---- Neon Auth (Better Auth) ----
NEON_AUTH_URL=https://your-neon-auth-url/api/auth
NEON_JWKS_URL=https://your-neon-auth-url/api/auth/jwks

# ---- Neon Object Storage (S3-compatible) ----
NEON_S3_ENDPOINT=https://<neon-storage-endpoint>
NEON_S3_REGION=us-east-1
NEON_S3_ACCESS_KEY=<key>
NEON_S3_SECRET_KEY=<secret>
NEON_S3_BUCKET=hms-assets
NEON_S3_PUBLIC_URL=https://<public-base>

# ---- App ----
CORS_ORIGINS=http://localhost:5173
VITE_API_URL=/api
