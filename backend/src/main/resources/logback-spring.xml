<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <include resource="org/springframework/boot/logging/logback/defaults.xml"/>

  <!-- Render-friendly: single line per event, request-correlated via MDC -->
  <!-- NOTE: value is a double-quoted XML attribute, so any literal " inside must be
       written as &quot; (XML has no backslash escaping — \" would end the attribute
       early and crash startup). Keep patterns free of raw quotes. -->
  <property name="CONSOLE_PATTERN"
            value="%d{yyyy-MM-dd'T'HH:mm:ss.SSSXXX} level=%-5level logger=%logger{36} req=%X{requestId:-} thread=%thread msg=&quot;%msg&quot;%n"/>

  <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
    <encoder>
      <pattern>${CONSOLE_PATTERN}</pattern>
      <charset>UTF-8</charset>
    </encoder>
  </appender>

  <!-- Quiet noisy loggers in prod -->
  <logger name="org.hibernate.SQL" level="WARN"/>
  <logger name="org.springframework.web" level="INFO"/>
  <logger name="com.hotel.hms" level="INFO"/>

  <root level="INFO">
    <appender-ref ref="CONSOLE"/>
  </root>
</configuration>
